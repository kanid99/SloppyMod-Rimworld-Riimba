<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RiimbaStation</defName>
    <label>riimba control station</label>
    <description>The brain and the garage for a team of Riimba cleaning drones. A basic subcore inside plans the routes; the drones themselves only execute them, and they stop dead outside the station's broadcast radius.

Set its broadcast radius with the command on the building: a wider ring covers more floor but costs sharply more power to hold, because the draw follows the area commanded rather than the distance.

Select it to see that radius and its three docking bays, which are the three open cells along the edge it faces. A unit drives up to its bay, turns, and reverses in under the overhang. Up to three sign on to one station. A docked unit charges and hands over whatever it has collected, and the station puts that waste down on the spot behind it - trash from ordinary dirt, wastepacks from anything that came out of a body.

Needs power to command and to charge. Cut the power and every unit signed on to it parks and waits.</description>
    <thingClass>RiimbaMod.Building_RiimbaStation</thingClass>
    <!-- Without this the def defaults to TickerType.Never and Tick() never runs, so the station
         never charges a docked unit, never drains its waste buffer, and never notices that a
         unit it is holding a slot for has been destroyed. -->
    <tickerType>Normal</tickerType>
    <!-- Load-bearing, and not obvious: BuildingBase sets MapMeshOnly, and Thing.DynamicDrawPhase
         returns without doing anything for a MapMeshOnly thing - so DrawAt is never called on it
         at all. That is what silently swallowed the docking overhang: Building_RiimbaStation.DrawAt
         was correct and simply never ran. MapMeshAndRealTime keeps the chassis printed into the map
         mesh, as a static building should be, AND gets DrawAt called every frame for the overhang.
         It does not double-draw the chassis: Thing.DrawAt only draws the graphic itself when
         drawerType is RealtimeOnly. -->
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Riimba/RiimbaStation</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- Authored at the footprint's exact 3:2 aspect, so the art lands inside its own cells.
           The overhang that masks a docking unit is a SEPARATE texture drawn above pawns by
           Building_RiimbaStation - see RiimbaStationLip. -->
      <drawSize>(3,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(3,2)</size>
    <costList>
      <Steel>170</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <!-- NOT THE WHOLE COST. RiimbaMod.RiimbaDefPatches appends a basic subcore to this list at
           StaticConstructorOnStartup, so what the game charges is this plus one subcore. It is
           done in C# rather than named here so the def resolves against whatever this install
           actually has, instead of raising a config error where it does not exist. The same
           file attaches this building's research prerequisites. -->
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <!-- Biotech rather than Production: nothing is produced here. It is mech infrastructure,
         built around a subcore, and it belongs next to the gestator that makes its drones. -->
    <designationCategory>Biotech</designationCategory>
    <rotatable>true</rotatable>
    <!-- Uninstall and reinstall without losing the team: Building_RiimbaStation.DeSpawn hands
         its units back rather than stranding them bound to a building in a crate. -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <!-- Required of anything minifiable, so the crated station has a place in stockpile filters. -->
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <!-- Draws the broadcast radius and the docking bays while the building is still on the
         cursor, so its orientation and reach can be judged before it is committed. -->
    <placeWorkers>
      <li>RiimbaMod.PlaceWorker_RiimbaStation</li>
    </placeWorkers>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>5200</WorkToBuild>
      <Mass>55</Mass>
      <Flammability>0.4</Flammability>
      <Beauty>-4</Beauty>
      <!-- Listed so they show on the info card; linked facilities raise them. -->
      <RiimbaChargeSpeed>1</RiimbaChargeSpeed>
      <RiimbaRadiusBonus>0</RiimbaRadiusBonus>
    </statBases>
    <researchPrerequisites>
      <li>RiimbaCleaning</li>
    </researchPrerequisites>
    <!-- Reach and team size are a mod extension rather than a comp: they are constants read off
         the def, with no per-building state to save, and a comp whose only job is to carry
         three numbers is a comp that has to be looked up on every call for nothing. -->
    <modExtensions>
      <li Class="RiimbaMod.RiimbaStationExtension">
        <!-- Where a new station's radius slider starts, and how far it goes either way. -->
        <radius>15</radius>
        <minRadius>6</minRadius>
        <maxRadius>30</maxRadius>
        <!-- Watts per tile of floor inside the ring, beyond what the smallest setting already
             covers - so the draw grows with the AREA commanded, not with the radius. At the
             default 15 that is about 119 W; at the full 30 it is about 543 W. See
             RiimbaStationExtension for why it is charged by area. -->
        <powerPerCoveredTile>0.2</powerPerCoveredTile>
        <maxUnits>3</maxUnits>
        <!-- Watts added per unit actually charging on a bay. -->
        <powerPerChargingUnit>150</powerPerChargingUnit>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <!-- The floor: the subcore thinking, with the ring at its smallest. The broadcast
             surcharge for a wider radius and the draw of any unit actually charging are added
             on top of this by Building_RiimbaStation. -->
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>RiimbaFastChargePad</li>
          <li>RiimbaSignalRelay</li>
          <li>RiimbaWasteHopper</li>
        </linkableFacilities>
      </li>
      <li Class="RiimbaMod.CompProperties_RiimbaWasteBuffer">
        <!-- One whole waste item per unit of buffered filth. -->
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <!-- Bodily fluids. Biotech's wastepack is the only sealed bio-waste item that is
             guaranteed present (Biotech is a hard dependency), and Vanilla Recycling Expanded
             already knows how to process one into a reclaimed biopack, so the pipeline the
             player has is the pipeline this feeds. Override here to point it at any other
             mod's biowaste item. -->
        <bioWasteDefNames>
          <li>Wastepack</li>
        </bioWasteDefNames>
        <bioWasteLabel>wastepack</bioWasteLabel>
        <!-- VRecyclingE_Trash is Vanilla Recycling Expanded's "trash"; the rest are fallbacks
             for other recycling mods. -->
        <trashWasteDefNames>
          <li>VRecyclingE_Trash</li>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
        <trashWasteLabel>trash</trashWasteLabel>
      </li>
    </comps>
  </ThingDef>

</Defs>
