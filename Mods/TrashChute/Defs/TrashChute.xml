<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The trash chute: Vanilla Expanded Framework's pipe system, carrying trash from Riimba control
    stations to a garbage compactor or a chute outlet. This whole folder is loaded only when
    Vanilla Recycling Expanded and the framework are both active - see LoadFolders.xml - which is
    why it can name VRecyclingE_Trash and PipeSystem classes freely.

    One unit of the network's resource is one trash item, everywhere: the station tank takes
    whole items, the compactor intake loads whole items, and the outlet's ratio is 1.
  -->

  <PipeSystem.PipeNetDef>
    <defName>RiimbaTrashChuteNet</defName>
    <resource>
      <name>Trash</name>
      <unit>items</unit>
      <color>(0.62, 0.53, 0.36)</color>
      <!-- Nothing produces trash per tick; it arrives in stations' tanks in lumps, so the
           production-and-consumption readout would always read zero. Show what is stored. -->
      <onlyShowStored>true</onlyShowStored>
    </resource>
    <pipeDefs>
      <li>RiimbaTrashChute</li>
      <li>RiimbaTrashChuteHidden</li>
    </pipeDefs>
    <overlayOptions>
      <overlayColor>(0.62, 0.53, 0.36)</overlayColor>
    </overlayOptions>
    <!-- A deconstruct tool that touches only chutes, and shows the chute overlay while it is
         held. It matters more than it would for visible pipe: a buried chute cannot be clicked
         on, so this is how one is found and taken up. -->
    <designator>
      <deconstructIconPath>UI/Designators/Deconstruct</deconstructIconPath>
      <designationCategoryDef>Biotech</designationCategoryDef>
    </designator>
  </PipeSystem.PipeNetDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RiimbaTrashChute</defName>
    <label>trash chute</label>
    <description>A sealed duct that carries trash between Riimba control stations, garbage compactors and trash chute outlets. Lay it touching a station to take the station's trash away automatically, and run it to a garbage compactor to have the compactor loaded without a hauler, or to a chute outlet to have the trash come out somewhere else.\n\nIt can run under walls, which hide it. To hide it under a floor, use the buried trash chute instead.\n\nOnly used when the Riimba mod settings send trash to the chute. Wastepacks never go down it.</description>
    <thingClass>PipeSystem.Building_Pipe</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Riimba/Chute/RiimbaTrashChute_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- The built pipe draws through the framework's own linked graphic, which links by
           network. These only make blueprints and frames link with each other as they are laid. -->
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Custom8</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.32,1,0.36)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Riimba/Chute/RiimbaTrashChute_MenuIcon</uiIconPath>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <drawerType>MapMeshOnly</drawerType>
    <building>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>60</WorkToBuild>
      <Flammability>0.6</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>2</Steel>
    </costList>
    <drawStyleCategory>Riimba_ChuteLines</drawStyleCategory>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <clearBuildingArea>false</clearBuildingArea>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Biotech</designationCategory>
    <researchPrerequisites>
      <li>RiimbaCleaning</li>
    </researchPrerequisites>
    <comps>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>RiimbaTrashChuteNet</pipeNet>
      </li>
    </comps>
    <placeWorkers>
      <li>PipeSystem.PlaceWorker_Pipe</li>
    </placeWorkers>
  </ThingDef>

  <!--
    The same chute, laid under the floor. Draws nothing once built (Building_HiddenChute), is not
    selectable - clicking what looks like bare floor should not select a pipe - and is found with
    the chute overlay and taken up with the chute deconstruct tool. The price of not seeing it is
    paid in steel and in build time, and it drops the visible chute's beauty penalty, which is the
    point of burying it.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>RiimbaTrashChuteHidden</defName>
    <label>buried trash chute</label>
    <description>A trash chute laid under the floor. It joins up with ordinary trash chute and does the same job, but it cannot be seen once built, so it does not spoil a room's beauty. It costs more and takes longer to lay.\n\nBuried chute cannot be clicked on. Open the trash chute overlay to see where it runs, and use the trash chute deconstruct tool to take it up.</description>
    <thingClass>RiimbaChute.Building_HiddenChute</thingClass>
    <category>Building</category>
    <graphicData>
      <!-- Never drawn once built, but the blueprint and frame are made from it, and the
           framework builds its linked pipe graphic from this path for every pipe def. -->
      <texPath>Things/Building/Riimba/Chute/RiimbaTrashChute_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Custom8</li>
      </linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/Riimba/Chute/RiimbaTrashChuteHidden_MenuIcon</uiIconPath>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <drawerType>MapMeshOnly</drawerType>
    <!-- Scratches and cracked corners are printed by a separate section layer, straight from
         hit points, whether or not the building draws itself. -->
    <drawDamagedOverlay>false</drawDamagedOverlay>
    <selectable>false</selectable>
    <building>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>180</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <costList>
      <Steel>4</Steel>
    </costList>
    <drawStyleCategory>Riimba_ChuteLines</drawStyleCategory>
    <rotatable>false</rotatable>
    <clearBuildingArea>false</clearBuildingArea>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Biotech</designationCategory>
    <researchPrerequisites>
      <li>RiimbaCleaning</li>
    </researchPrerequisites>
    <comps>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>RiimbaTrashChuteNet</pipeNet>
      </li>
    </comps>
    <placeWorkers>
      <li>PipeSystem.PlaceWorker_Pipe</li>
    </placeWorkers>
  </ThingDef>

  <!--
    Where the chute lets trash out as items, onto its own cell. A storage building, so a hauler, a
    stockpile's worth of priority or a conveyor belt can take from it - which is what makes the
    chute useful without a compactor at the end of it. The framework drains stations' tanks into
    it on its own tick; it needs no code of ours.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>RiimbaChuteOutlet</defName>
    <label>trash chute outlet</label>
    <description>The end of a trash chute. Trash carried down the chute comes out here as items, stacked on the outlet, for haulers or a conveyor belt to take away. Use the stack controls to set how much it lets pile up before it holds the rest back in the chute.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Things/Building/Riimba/Chute/RiimbaChuteOutlet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0.3</fillPercent>
    <pathCost>30</pathCost>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <costList>
      <Steel>30</Steel>
    </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>700</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.4</Flammability>
    </statBases>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>VRecyclingE_Trash</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>VRecyclingE_Trash</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Biotech</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <researchPrerequisites>
      <li>RiimbaCleaning</li>
    </researchPrerequisites>
    <comps>
      <li Class="PipeSystem.CompProperties_ConvertResourceToThing">
        <pipeNet>RiimbaTrashChuteNet</pipeNet>
        <thing>VRecyclingE_Trash</thing>
        <ratio>1</ratio>
      </li>
    </comps>
  </ThingDef>

</Defs>
